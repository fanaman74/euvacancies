# Postgres connection. On Railway this is injected from the Postgres service.
DATABASE_URL=postgresql://postgres:password@localhost:5432/euemployment

# Web server
PORT=3000
NODE_ENV=development

# Daily sweep. The container may run in UTC; the schedule is pinned to London.
SYNC_TIMEZONE=Europe/London
SYNC_CRON=0 9 * * *

# Source
EU_CATEGORY_URL=https://euemployment.eu/category/vacancies/
EU_CATEGORY_ID=749
EU_POSTS_PER_PAGE=30

# Optional: enables POST /api/sync with an Authorization: Bearer <secret> header.
# Leave unset to keep the endpoint disabled.
SYNC_SECRET=
